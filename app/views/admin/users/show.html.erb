<% content_for :title, @user.display_name %>

<%= render "shared/admin_breadcrumb", tenant: @tenant, current: :tenant %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0"><%= @user.display_name %></h1>
  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_admin_tenant_user_path(@tenant, @user), class: "btn btn-sm btn-outline-primary" %>
    <%= link_to "Back to #{@tenant.name}", admin_tenant_path(@tenant), class: "btn btn-sm btn-outline-secondary" %>
  </div>
</div>

<div class="card shadow-sm mb-3">
  <div class="card-header"><h2 class="h5 mb-0">Profile</h2></div>
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Full name</dt>
      <dd class="col-sm-9">
        <%= @user.full_name.presence || content_tag(:span, "—", class: "text-muted") %>
      </dd>

      <dt class="col-sm-3">Email</dt>
      <dd class="col-sm-9"><%= @user.email %></dd>

      <dt class="col-sm-3">Title</dt>
      <dd class="col-sm-9">
        <%= @user.title.presence || content_tag(:span, "—", class: "text-muted") %>
      </dd>

      <dt class="col-sm-3">Phone number</dt>
      <dd class="col-sm-9">
        <%= @user.phone_number.presence || content_tag(:span, "—", class: "text-muted") %>
      </dd>

      <dt class="col-sm-3">Time zone</dt>
      <dd class="col-sm-9"><%= @user.time_zone %></dd>
    </dl>
  </div>
</div>

<div class="card shadow-sm mb-3">
  <div class="card-header"><h2 class="h5 mb-0">Organization</h2></div>
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Tenant</dt>
      <dd class="col-sm-9"><%= @tenant.name %></dd>

      <dt class="col-sm-3">Location</dt>
      <dd class="col-sm-9">
        <% if @user.location %>
          <%= @user.location.display_name %>
        <% else %>
          <span class="text-muted">— None (account admin)</span>
        <% end %>
      </dd>

      <dt class="col-sm-3">Role</dt>
      <dd class="col-sm-9">
        <% if @user.is_admin %>
          <span class="badge text-bg-dark">Application Admin</span>
        <% elsif @user.is_tenant_admin? %>
          <span class="badge text-bg-info">Tenant Admin</span>
        <% else %>
          <span class="badge text-bg-secondary">Originator</span>
        <% end %>
      </dd>

      <dt class="col-sm-3">Status</dt>
      <dd class="col-sm-9">
        <% if @user.is_pending %>
          <span class="badge text-bg-warning">Pending</span>
        <% else %>
          <span class="badge text-bg-success">Active</span>
        <% end %>
      </dd>
    </dl>
  </div>
</div>

<div class="card shadow-sm mb-3">
  <div class="card-header"><h2 class="h5 mb-0">Gmail connections (<%= @delegations.size %>)</h2></div>
  <div class="card-body p-0">
    <% if @delegations.any? %>
      <table class="table mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>Address</th>
            <th>Provider</th>
            <th>Token status</th>
            <th>Permissions granted</th>
            <th>Connected</th>
          </tr>
        </thead>
        <tbody>
          <% @delegations.each do |d| %>
            <tr>
              <td><%= d.email %></td>
              <td><%= d.provider %></td>
              <td>
                <% if d.expires_at.nil? %>
                  <span class="text-muted">—</span>
                <% elsif d.expired? %>
                  <span class="badge text-bg-warning">Expired</span>
                  <span class="text-muted small ms-1"><%= d.expires_at.to_fs(:long) %></span>
                <% else %>
                  <span class="badge text-bg-success">Valid</span>
                  <span class="text-muted small ms-1">until <%= d.expires_at.to_fs(:long) %></span>
                <% end %>
              </td>
              <td>
                <% if d.granted_scopes.any? %>
                  <div class="d-flex flex-wrap gap-1">
                    <% d.granted_scopes.each do |scope| %>
                      <% is_send = scope == EmailDelegation::GMAIL_SEND_SCOPE %>
                      <span class="badge <%= is_send ? "text-bg-success" : "text-bg-light border" %>">
                        <%= oauth_scope_label(scope) %>
                      </span>
                    <% end %>
                  </div>
                  <% unless d.can_send? %>
                    <div class="text-danger small mt-1">
                      Missing the “Send email” permission — campaign sends from this account will fail.
                    </div>
                  <% end %>
                <% else %>
                  <span class="text-muted small">Not recorded</span>
                <% end %>
              </td>
              <td><%= d.created_at.to_fs(:long) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="p-3 text-center text-muted small">No Gmail account connected.</div>
    <% end %>
  </div>
</div>

<div class="card shadow-sm mb-3">
  <div class="card-header"><h2 class="h5 mb-0">Sign-in activity</h2></div>
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Sign-in count</dt>
      <dd class="col-sm-9"><%= @user.sign_in_count %></dd>

      <dt class="col-sm-3">Current sign-in</dt>
      <dd class="col-sm-9">
        <% if @user.current_sign_in_at %>
          <%= @user.current_sign_in_at.to_fs(:long) %>
          <% if @user.current_sign_in_ip.present? %>
            <span class="text-muted small ms-1">from <%= @user.current_sign_in_ip %></span>
          <% end %>
        <% else %>
          <span class="text-muted">— Never</span>
        <% end %>
      </dd>

      <dt class="col-sm-3">Last sign-in</dt>
      <dd class="col-sm-9">
        <% if @user.last_sign_in_at %>
          <%= @user.last_sign_in_at.to_fs(:long) %>
          <% if @user.last_sign_in_ip.present? %>
            <span class="text-muted small ms-1">from <%= @user.last_sign_in_ip %></span>
          <% end %>
        <% else %>
          <span class="text-muted">— Never</span>
        <% end %>
      </dd>

      <dt class="col-sm-3">Remembered since</dt>
      <dd class="col-sm-9">
        <%= @user.remember_created_at&.to_fs(:long) || content_tag(:span, "—", class: "text-muted") %>
      </dd>
    </dl>
  </div>
</div>

<div class="card shadow-sm">
  <div class="card-header"><h2 class="h5 mb-0">Record</h2></div>
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">User ID</dt>
      <dd class="col-sm-9"><%= @user.id %></dd>

      <dt class="col-sm-3">Created</dt>
      <dd class="col-sm-9"><%= @user.created_at.to_fs(:long) %></dd>

      <dt class="col-sm-3">Last updated</dt>
      <dd class="col-sm-9"><%= @user.updated_at.to_fs(:long) %></dd>
    </dl>
  </div>
</div>
