<!DOCTYPE html>
<html>
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="SMAI">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/favicon.png">

    <link rel="stylesheet" href="/bootstrap/bootstrap.min.css">
    <script src="/bootstrap/bootstrap.bundle.min.js" defer></script>
    <script src="/Sortable.min.js" defer></script>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

  </head>

  <body<% if user_signed_in? %> data-poll-url="<%= current_poll_url %>" data-poll-interval="10000"<% end %>>
    <header class="sticky-top app-header">
      <% if user_signed_in? && current_user.is_admin && (missing = missing_env_vars).any? %>
        <div class="alert alert-warning rounded-0 mb-0 small text-center">
          <strong>Missing env vars:</strong> <%= missing.join(", ") %>. See <code>.env.example</code>.
        </div>
      <% end %>
      <% if user_signed_in? && current_user.full_name.blank? && !(controller_name == "profiles" && action_name == "edit") %>
        <div class="alert alert-warning rounded-0 mb-0 small text-center">
          Your profile is missing a name, so outgoing emails will only show your email address.
          <%= link_to "Add your name", edit_profile_path, class: "alert-link" %>.
        </div>
      <% end %>
      <%= render "layouts/navbar" %>
    </header>

    <% if user_signed_in? %>
      <div class="container-fluid">
        <div class="row">
          <%= render "layouts/sidebar" %>
          <main class="col-md-9 col-lg-10 py-4">
            <% if notice %><div class="alert alert-success" role="alert"><%= notice %></div><% end %>
            <% if alert %><div class="alert alert-danger" role="alert"><%= alert %></div><% end %>
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <div class="container py-4">
        <% if notice %><div class="alert alert-success" role="alert"><%= notice %></div><% end %>
        <% if alert %><div class="alert alert-danger" role="alert"><%= alert %></div><% end %>
        <%= yield %>
      </div>
    <% end %>
    <%= render "layouts/footer" %>

    <% if user_signed_in? %>
      <%# Cheap polling for the sidebar/home "Needs Attention" badge and the
          proposals-list "Update available" refresh banner. Issue #240: a
          background Sidekiq job (Gmail reply poll, sweep job) updates a
          proposal but the operator's open tab has no way to know — so this
          tiny poller fetches a count + scope signature every 10s and
          updates the DOM in place. The badge live-updates; the list does
          NOT auto-replace itself, just surfaces a refresh button so the
          operator picks the moment they re-render. %>
      <script>
        (function () {
          var url = document.body.dataset.pollUrl;
          if (!url) return;
          var interval = parseInt(document.body.dataset.pollInterval, 10) || 10000;
          var timer = null;

          function schedule() {
            if (timer) clearTimeout(timer);
            timer = setTimeout(tick, interval);
          }

          function tick() {
            if (document.hidden) { schedule(); return; }
            fetch(url, { headers: { "Accept": "application/json" }, credentials: "same-origin" })
              .then(function (r) { return r.ok ? r.json() : null; })
              .then(function (data) { if (data) applyUpdate(data); })
              .catch(function () { /* network blip; try again next tick */ })
              .finally(schedule);
          }

          function applyUpdate(data) {
            var n = data.needs_attention_count;
            if (typeof n === "number") {
              var badges = document.querySelectorAll("[data-poll-needs-attention-badge]");
              for (var i = 0; i < badges.length; i++) {
                badges[i].textContent = n;
                if (n === 0) {
                  badges[i].setAttribute("hidden", "");
                } else {
                  badges[i].removeAttribute("hidden");
                }
              }
            }

            var sigEl = document.querySelector("[data-poll-signature]");
            if (sigEl && data.list_signature) {
              var initial = sigEl.dataset.pollSignature;
              if (initial && data.list_signature !== initial) {
                var banner = document.querySelector("[data-poll-refresh-banner]");
                if (banner) banner.removeAttribute("hidden");
              }
            }
          }

          document.addEventListener("visibilitychange", function () {
            if (!document.hidden) tick();
          });

          document.addEventListener("click", function (e) {
            var btn = e.target.closest && e.target.closest("[data-poll-refresh-button]");
            if (btn) { e.preventDefault(); window.location.reload(); }
          });

          schedule();
        })();
      </script>
    <% end %>
  </body>
</html>
